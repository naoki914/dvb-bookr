javascript:(function () {function openTabsWithDelay(urls,delay) {jscript=`(function () {    var member=document.querySelector('#mem_nm');%20%20%20%20var%20team=document.querySelector('#team_nm');%20%20%20%20var%20team_yn1=document.querySelector('#team_yn1');%20%20%20%20var%20users=document.querySelector('#users');%20%20%20%20var%20mobile=document.querySelector('#mobile_tel');%20%20%20%20var%20phone=document.querySelector('#tel');%20%20%20%20var%20type_cd1=document.querySelector('#type_cd1');%20%20%20%20var%20title=document.querySelector('#title');%20%20%20%20var%20purpose=document.querySelector('#purpose');%20%20%20%20var%20agree_checkbox=document.querySelector('#agree_use1');%20%20%20%20var%20apply_button=document.querySelector('#writeBtn');%20%20%20%20if%20(member)%20member.value='%EA%B9%80%EC%8A%B9%EC%9C%A4';%20%20%20%20if%20(team)%20team.value='DVB';%20%20%20%20if%20(team_yn1)%20team_yn1.checked=true;%20%20%20%20if%20(users)%20users.value='18';%20%20%20%20if%20(mobile)%20mobile.value='010-2293-2050';%20%20%20%20if%20(phone)%20phone.value='';%20%20%20%20if%20(type_cd1)%20type_cd1.checked=true;%20%20%20%20if%20(title)%20title.value='%EB%B0%B0%EA%B5%AC';%20%20%20%20if%20(purpose)%20purpose.value='%EB%B0%B0%EA%B5%AC';%20%20%20%20if%20(agree_checkbox)%20agree_checkbox.checked=true;%20%20%20%20if(apply_button)apply_button.click();})();%60;urls.forEach(function(url,index)%20{%20%20%20%20var%20newTab=window.open(url,'_blank');%20%20%20%20newTab.eval('window.alert=function()%20{};');%20%20%20%20newTab.addEventListener('load',function()%20{%20%20%20%20%20%20%20%20newTab.eval(jscript);%20%20%20%20});});}function%20getSundaysForComingMonth()%20{const%20today=new%20Date();const%20year=today.getFullYear();const%20month=today.getMonth();const%20firstDayNextMonth=new%20Date(year,month%20+%201,1);const%20lastDayNextMonth=new%20Date(year,month%20+%202,0);const%20sundays=[];let%20date=new%20Date(firstDayNextMonth);date.setDate(date.getDate()%20+%20(7%20-%20date.getDay())%20%%207);while%20(date%20%3C=%20lastDayNextMonth)%20{%20%20%20%20const%20yyyy=date.getFullYear();%20%20%20%20const%20mm=String(date.getMonth()%20+%201).padStart(2,'0');%20%20%20%20const%20dd=String(date.getDate()).padStart(2,'0');%20%20%20%20sundays.push(%60${yyyy}${mm}${dd}%60);%20%20%20%20date.setDate(date.getDate()%20+%207);}return%20sundays;}function%20getUrls()%20{const%20urls=[];const%20sundays=getSundaysForComingMonth();const%20after=new%20Date(new%20Date().getFullYear(),new%20Date().getMonth()%20+%201,1);const%20base_date=%60${after.getFullYear()}${String(after.getMonth()%20+%201).padStart(2,'0')}01%60;const%20time_no='141;9%ED%9A%8C;1400;1450;1|142;10%ED%9A%8C;1500;1550;1|143;11%ED%9A%8C;1600;1650;1|144;12%ED%9A%8C;1700;1750;1';const%20encoded_time_no=encodeURIComponent(time_no);sundays.forEach(element%20=%3E%20{%20%20%20%20urls.push(%60https://www.e-junggu.or.kr/fmcs/314?facilities_type=C&center=JUNGGU03&part=02&base_date=${base_date}&action=write&place=7&comcd=JUNGGU03&part_cd=02&place_cd=7&time_no=${encoded_time_no}&rent_date=${element}%60);});return%20urls;}openTabsWithDelay(getUrls(),50);})()